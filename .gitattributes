# 统一换行符：容器内执行的脚本必须是 LF，否则 sh 报 set: Illegal option -
*.sh text eol=lf
Dockerfile text eol=lf

# VERSION 也必须是 LF：CI 里 `$(cat VERSION)` 会连 `\r` 一起读进镜像 tag，
# docker 报 `invalid reference format`（第 150 期实测踩到）。
VERSION text eol=lf

# .dockerignore 也锁定 LF：本机 core.autocrlf=true，若不锁定，
# 忽略规则会被写成 CRLF，容易在匹配时踩坑。
.dockerignore text eol=lf
