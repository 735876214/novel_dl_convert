# 复制为 .env 后填写；也可直接在 docker-compose.yml 的 environment 段写死。
# 以下变量容器启动时会注入，供 AI 分章兜底（不填则不联网，纯正则分章）。

# AI 分章兜底（可选）：配置后疑难章节自动调用 LLM
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 时区（容器内默认 Asia/Shanghai，一般无需改）
TZ=Asia/Shanghai

# ---- 阅读端（Batch 2）：单用户轻登录 + 持久化 ----
# 登录账号 / 密码：**仅首次启动**（账号不存在时）写入 SQLite users 表。
# 之后请在「设置 → 账户 → 修改密码」里改；重启不会覆盖（AUTH_PIN 只用于初始化）。
# 不设置则回退内置默认 admin / changeme（仅供本地试用，生产务必修改）。
AUTH_USER=admin
AUTH_PIN=changeme
# Token 签名密钥：改成一段随机长串，泄露会导致登录态可被伪造。
AUTH_SECRET=change-this-to-a-long-random-string

# 持久化数据目录（SQLite：阅读进度 / 批注 / 账号）；须挂载到宿主机卷以跨重启保留。
DATA_DIR=/app/data

# 可选：MOBI / AZW3 派生所需的 Calibre ebook-convert 路径。
# 不设置则按 PATH 查找；找不到时「输出格式」为 mobi / azw3 的任务会自动降级为 EPUB。
EBOOK_CONVERT_BIN=
